{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": { "BUILD_GUI": "ON" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (okCameraApp)",
      "description": "Optimized build of the okCameraApp GUI - the default for trying the app.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (okCameraApp)",
      "description": "Debug build with symbols, for stepping through the source.",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug",   "configurePreset": "debug",   "configuration": "Debug" }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Release (configure + build)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "debug",
      "displayName": "Debug (configure + build)",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    }
  ]
}
